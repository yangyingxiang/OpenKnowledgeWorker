# Copy to .env at the repository root and fill in what you need.
# Docker Compose reads this file too (DATABASE_URL is set by compose itself).

# --- LLM provider ---------------------------------------------------------
# anthropic (default) or openai (any OpenAI-compatible API: OpenAI, Ollama, vLLM, LiteLLM, ...)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 for Anthropic; required for openai.
LLM_MODEL=
# Anthropic only: retry safety declines on a fallback model server-side (1/0).
LLM_SERVER_FALLBACK=1

# For LLM_PROVIDER=openai:
OPENAI_API_KEY=
# Leave empty for api.openai.com; e.g. http://localhost:11434/v1 for Ollama
# (from Docker Compose, use http://host.docker.internal:11434/v1).
OPENAI_BASE_URL=

# --- Backend --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/openknowledgeworker
# Allowed CORS origin (the frontend URL)
FRONTEND_URL=http://localhost:3000
# Uploaded source documents (relative to backend/, or an absolute path)
UPLOAD_DIR=uploads
# Seconds before a sandboxed run of generated code is stopped
SANDBOX_TIMEOUT=120
# Folder with domain packs (default: the repository's examples/)
DOMAIN_PACKS_DIR=

# Dev server (python backend/run.py). Set FLASK_DEBUG=1 only on a trusted machine.
HOST=127.0.0.1
PORT=5003
FLASK_DEBUG=0
